# Dependencies
node_modules/

# Test / tooling output
test-results/
playwright-report/
.playwright/
coverage/

# Python bytecode from the deck host (docker/app)
__pycache__/
*.py[cod]

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Local, private decks — don't publish personal presentations.
# Committed examples/ decks are the exception (they're documentation).
/*.izerp
!examples/*.izerp

# Decks uploaded to a locally running deck host (docker/) — these are the
# user's own presentations, not part of the project.
/decks/
/docker/decks/

# NOTE: dist/ is intentionally committed so jsDelivr/unpkg can serve the
# minified build straight from a git tag. Regenerate it with `npm run build`.
